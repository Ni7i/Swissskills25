<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PopulationSimulation.Views.ConfirmDialog"
        Title="Confirm" Width="400" Height="170"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,15,0,0" Spacing="10">
            <Button Content="Yes" Width="80" Click="Yes_Click"/>
            <Button Content="No" Width="80" Click="No_Click"/>
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14"/>
    </DockPanel>
</Window>
